generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}

model Project {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  nextTaskNumber Int      @default(0)
  description    String?
  sprints        Sprint[]
  columns        Column[]
  tasks          Task[]
  labels         Label[]
  plugins        ProjectPlugin[]
}

model ProjectPlugin {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pluginId  String
  isActive  Boolean @default(false)

  @@unique([projectId, pluginId])
}
