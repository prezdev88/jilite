generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}

model Project {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  nextTaskNumber Int      @default(0)
  description    String?
  statuses       Status[]
  tasks          Task[]
  labels         Label[]
  plugins        ProjectPlugin[]
}

model ProjectPlugin {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pluginId  String
  isActive  Boolean @default(false)

  @@unique([projectId, pluginId])
}

// Estados del flujo de trabajo (Core Statuses)
model Status {
  id        String  @id @default(cuid())
  name      String
  order     Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Task {
  id     String  @id @default(cuid())
  number Int
  title  String
  detail String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  statusId String?
  status   Status? @relation(fields: [statusId], references: [id])
  
  labels   Label[]

  order Int @default(0)

  @@unique([projectId, number])
}

model Label {
  id        String  @id @default(cuid())
  name      String
  color     String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, name])
}
