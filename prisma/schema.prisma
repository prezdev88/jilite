generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Project {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  nextTaskNumber Int      @default(0)
  description    String?
  sprints        Sprint[]
  columns        Column[]
  tasks          Task[]
  labels         Label[]
  plugins        ProjectPlugin[]
}

model ProjectPlugin {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pluginId  String
  isActive  Boolean @default(false)

  @@unique([projectId, pluginId])
}

model Column {
  id        String  @id @default(cuid())
  name      String
  order     Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Sprint {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean @default(false)
  tasks     Task[]
}

model Task {
  id     String  @id @default(cuid())
  number Int
  title  String
  detail String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id])

  columnId String?
  column   Column? @relation(fields: [columnId], references: [id])
  labels   Label[]

  order Int @default(0)

  @@unique([projectId, number])
}

model Label {
  id        String  @id @default(cuid())
  name      String
  color     String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, name])
}
